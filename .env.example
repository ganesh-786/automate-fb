# Copy this file to `.env` and fill in only what you need. `.env` is git-ignored.
# Each Phase 0 spike is skipped until its variables are set. Setup steps: docs/phase-0/README.md

# --- script-gemini: Google AI Studio API key -------------------------------------------------
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# --- image-cloudflare: Workers AI ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
# API token with the "Workers AI" permission.
CLOUDFLARE_API_TOKEN=

# --- publish-facebook-reel: Meta Graph API ---------------------------------------------------
META_PAGE_ID=
# Page access token with pages_show_list, pages_read_engagement, pages_manage_posts.
META_PAGE_ACCESS_TOKEN=
# Optional. When set, every Graph call is signed with appsecret_proof.
META_APP_SECRET=
# Optional. Defaults to v25.0.
META_GRAPH_VERSION=

# --- publish-buffer-tiktok: Buffer API -------------------------------------------------------
BUFFER_API_KEY=
# Optional. Defaults to the first organization on the account.
BUFFER_ORGANIZATION_ID=
# Public HTTPS URL of an MP4 that Buffer can download (for example an R2 public link).
SPIKE_PUBLIC_VIDEO_URL=
