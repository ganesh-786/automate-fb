{
  "name": "automate",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt-to-published short-video pipeline: standalone services orchestrated by n8n, with human approval before every publish.",
  "author": "ganesh-786",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "spikes/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "spike": "node spikes/phase-0/src/cli.ts"
  },
  "overrides": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "sharp": false
  }
}
